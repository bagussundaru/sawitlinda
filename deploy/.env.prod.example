# Salin ke .env di root proyek pada server, lalu isi. JANGAN commit berkas .env.
#
#   cp deploy/.env.prod.example .env && chmod 600 .env

# --- Database ---
POSTGRES_USER=sawitscan
# Buat yang acak & panjang, mis.:  openssl rand -base64 24
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK
POSTGRES_DB=sawitscan

# --- Alamat publik aplikasi ---
# Domain atau http://<IP-VM>:<port>. Dipakai untuk CORS dan sebagai alamat API
# yang dipanggil browser.
PUBLIC_URL=https://sawit.contoh.id

# Asal frontend yang boleh mengakses API. Samakan dengan PUBLIC_URL.
CORS_ORIGINS=https://sawit.contoh.id

# Alamat API dari sisi browser. Kalau frontend & backend di balik satu domain
# lewat reverse proxy, ini cukup PUBLIC_URL.
NEXT_PUBLIC_API_URL=https://sawit.contoh.id

# --- Port di host ---
# Keduanya hanya di-bind ke 127.0.0.1. Ubah bila port ini sudah dipakai
# aplikasi lain di VM — cek dulu dengan deploy/survey.sh.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Batas ukuran satu citra (MB).
MAX_UPLOAD_MB=50
