# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://sawitscan:sawitscan@localhost:5432/sawitscan

# Where uploaded UAV images are stored (relative to backend/)
STORAGE_DIR=storage

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Path to the trained model file. Unused while inference is mocked —
# see docs/SWAP_MODEL.md.
MODEL_PATH=
