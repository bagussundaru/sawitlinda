# Copy to .env and adjust. Never commit .env.

# --- Wajib di produksi ---
# Kredensial database hanya lewat berkas ini, jangan pernah ditulis di kode.
DATABASE_URL=postgresql+psycopg://sawitscan:sawitscan@localhost:5432/sawitscan

# Asal (origin) frontend yang boleh mengakses API, dipisah koma.
# Di produksi ganti dengan domain sebenarnya — jangan biarkan localhost.
CORS_ORIGINS=http://localhost:3000

# --- Opsional ---
# Lokasi penyimpanan citra UAV yang diunggah, relatif terhadap backend/.
STORAGE_DIR=storage

# Batas ukuran satu citra (MB). Melindungi disk dari unggahan yang tidak wajar.
MAX_UPLOAD_MB=50

# Path berkas model terlatih. Belum dipakai selama inference masih mock —
# lihat docs/SWAP_MODEL.md.
MODEL_PATH=

# --- Analisis AI (Nebius Token Factory) ---
# Kosongkan untuk mematikan fitur; aplikasi tetap berjalan penuh tanpanya.
# JANGAN pernah menaruh kunci ini di dalam repositori.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
NEBIUS_TIMEOUT_S=90

# --- Autentikasi ---
# Buat akun pertama dengan: python scripts/create_user.py
# Selama belum ada akun, seluruh API menolak permintaan (bukan membukanya).
SESSION_HOURS=12
# WAJIB true di produksi (HTTPS). false hanya untuk http://localhost.
COOKIE_SECURE=false

# --- Mesin training GPU (Modal) ---
# Kosongkan untuk mematikan menu Training; sisa aplikasi tetap berjalan penuh.
# Lihat docs/TRAINING.md. Token ini memicu biaya GPU — perlakukan seperti kunci
# API, jangan pernah masuk repositori.
MODAL_TRAINING_URL=
MODAL_TRAINING_TOKEN=

# --- Mesin inference GPU (Modal) ---
# Kosong = deteksi dijalankan di CPU VM ini (±47 detik per bingkai UAV penuh).
# Diisi = bagian beratnya dikerjakan GPU; penggabungan, keparahan, dan
# georeferensi tetap dihitung di sini. Lihat docs/TRAINING.md.
# Token boleh sama dengan MODAL_TRAINING_TOKEN — keduanya memakai secret Modal
# yang sama.
MODAL_INFERENCE_URL=
MODAL_INFERENCE_TOKEN=
