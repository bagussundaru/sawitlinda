# Copy to .env and adjust. Never commit .env.

# --- Wajib di produksi ---
# Kredensial database hanya lewat berkas ini, jangan pernah ditulis di kode.
DATABASE_URL=postgresql+psycopg://sawitscan:sawitscan@localhost:5432/sawitscan

# Asal (origin) frontend yang boleh mengakses API, dipisah koma.
# Di produksi ganti dengan domain sebenarnya — jangan biarkan localhost.
CORS_ORIGINS=http://localhost:3000

# --- Opsional ---
# Lokasi penyimpanan citra UAV yang diunggah, relatif terhadap backend/.
STORAGE_DIR=storage

# Batas ukuran satu citra (MB). Melindungi disk dari unggahan yang tidak wajar.
MAX_UPLOAD_MB=50

# Path berkas model terlatih. Belum dipakai selama inference masih mock —
# lihat docs/SWAP_MODEL.md.
MODEL_PATH=
